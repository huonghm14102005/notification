DATABASE_URL=postgresql://notify:change-me@postgres:5432/notification
REDIS_URL=redis://redis:6379
LOG_LEVEL=Information
HEALTH_CHECK_TIMEOUT_SECONDS=3
WORKER_HEALTH_INTERVAL_SECONDS=10
WORKER_HEALTH_FILE=/tmp/notification-worker-health
SEED_TEST_ADMIN=true
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=notification-server
JWT_AUDIENCE=notification-admin
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
API_KEY_SALT=replace-with-at-least-16-random-bytes
ENCRYPTION_KEY=base64-encoded-exactly-32-random-bytes
SMTP_TIMEOUT_MS=30000
SWEEP_INTERVAL_SECONDS=300
STUCK_AFTER_SECONDS=600
CALLBACK_TIMEOUT_MS=10000
CALLBACK_POLL_INTERVAL_MS=2000
CALLBACK_CONCURRENCY=5
CALLBACK_STUCK_AFTER_SECONDS=120
CALLBACK_ALLOW_INSECURE_HTTP=false
CALLBACK_ALLOW_PRIVATE_NETWORK=false
GMAIL_SMTP_USERNAME=thay email cua ban
GMAIL_APP_PASSWORD= thay password cua ban
SMTP_TEST_RECIPIENT=thay email nhan
